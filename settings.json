{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "feature-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C ~/.claude fetch --quiet origin main 2>/dev/null; b=$(git -C ~/.claude rev-list --count HEAD..origin/main 2>/dev/null); if [ -n \"$b\" ] && [ \"$b\" -gt 0 ]; then printf '{\"systemMessage\":\"~/.claude (claude-setup) ist %s Commit(s) hinter origin/main \\u2014 git pull empfohlen.\"}' \"$b\"; fi",
            "timeout": 15,
            "statusMessage": "Prüfe ~/.claude auf Updates..."
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh start ~/.claude/hooks/playbook-status.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh other ~/.claude/hooks/test-lock-hook.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh other ~/.claude/hooks/test-lock-hook.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh commands ~/.claude/hooks/playbook-hook.js command-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh secrets ~/.claude/hooks/playbook-hook.js secret-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh other ~/.claude/hooks/test-lock-hook.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/node-hook.sh other ~/.claude/hooks/playbook-hook.js format-hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enableWorkflows": true
}
